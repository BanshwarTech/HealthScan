# ==============================================================================
# AI ENGINE CONFIGURATION (NVIDIA NIM is Primary / Default)
# ==============================================================================

# NVIDIA_API_KEY: Primary & Default AI Provider (NVIDIA NIM / NVIDIA AI Foundation)
# Get your free key at: https://build.nvidia.com/
NVIDIA_API_KEY="nvapi-your_nvidia_api_key_here"

# NVIDIA_MODEL: Default model for website security & remediation synthesis
# Options: meta/llama-3.3-70b-instruct, meta/llama-3.1-70b-instruct, mistralai/mixtral-8x22b-instruct-v0.1
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# GEMINI_API_KEY: Secondary Fallback Provider (Google Gemini API)
# AI Studio automatically injects this at runtime or configure via Secrets panel
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# PORT: Server listener port (defaults to 3000)
PORT=3000
